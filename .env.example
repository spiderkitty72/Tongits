# Name players see when they connect.
SERVER_NAME=Josh's Tong-its table
# Port on this machine the game is served on.
PORT=8080
# Database password (any long random string). Only the game server uses it.
POSTGRES_PASSWORD=change-me-to-something-long
# Who can create accounts: open, invite (needs INVITE_CODE) or closed.
SIGNUP_MODE=invite
INVITE_CODE=pick-a-code-for-your-friends
# Web addresses allowed to use this server from a browser. "*" lets any copy of the app connect.
CORS_ORIGINS=*
# Chips every new player starts with.
STARTING_CHIPS=100
# Accounts with these emails (comma-separated) get the Admin page once they sign up.
ADMIN_EMAILS=you@example.com
# Shown on "Forgot password?" so players can reach you: an email address or a web link.
ADMIN_CONTACT=you@example.com
