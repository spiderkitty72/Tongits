{
  "name": "@tongits/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/index.js"
  },
  "dependencies": {
    "@tongits/engine": "0.1.0",
    "pg": "8.16.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1"
  }
}
